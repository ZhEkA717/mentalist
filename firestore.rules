rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin access only (auth required)
    match /cards/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /texts/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /ribbonItems/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /media/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /config/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Requests — anyone can create, only admin can read/update/delete
    match /requests/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
