{
  "name": "mentalist",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "env": "node scripts/load-env.js",
    "start": "node scripts/load-env.js && ng serve",
    "build": "node scripts/load-env.js && ng build",
    "deploy": "npm run build && firebase deploy --only hosting",
    "watch": "node scripts/load-env.js && ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@maskito/angular": "^5.3.1",
    "@maskito/core": "^5.3.1",
    "@maskito/kit": "^5.3.1",
    "@ng-web-apis/common": "^5.3.0",
    "@ng-web-apis/intersection-observer": "^5.3.0",
    "@ng-web-apis/platform": "^5.3.0",
    "@ng-web-apis/screen-orientation": "^5.3.0",
    "@taiga-ui/cdk": "^5.16.0",
    "@taiga-ui/core": "^5.16.0",
    "@taiga-ui/design-tokens": "^0.311.0",
    "@taiga-ui/event-plugins": "^5.0.0",
    "@taiga-ui/font-watcher": "^0.6.0",
    "@taiga-ui/i18n": "^5.16.0",
    "@taiga-ui/icons": "^5.17.0",
    "@taiga-ui/kit": "^5.16.0",
    "@taiga-ui/layout": "^5.16.0",
    "@taiga-ui/polymorpheus": "^5.0.1",
    "@taiga-ui/styles": "^5.16.0",
    "firebase": "^12.16.0",
    "gsap": "^3.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.19",
    "@angular/build": "^21.0.1",
    "@angular/cli": "^21.0.1",
    "@angular/compiler-cli": "^21.0.0",
    "@ngx-env/builder": "^21.0.1",
    "dotenv": "^17.4.2",
    "jsdom": "^27.1.0",
    "less": "^4.8.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
